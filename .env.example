# Copy to .env and fill in. Never commit the real .env.

# --- App ---
APP_NAME="AstroBro AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-64-char-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_CLASSIFIER_MODEL=qwen/qwen3.8-27b
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Vector DB (Qdrant Cloud) ---
QDRANT_URL=
QDRANT_API_KEY=
BOOKS_COLLECTION=vedic_books
# Tarot, numerology, Vastu, festival, calendar and Puranic-lore books (see scripts/free_books.py). Empty disables it.
SPECIALIST_COLLECTION=specialist_books

# --- Embeddings (run locally with fastembed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Astrology ---
AYANAMSA=LAHIRI
HOUSE_SYSTEM=W
DASHA_SYSTEM=vimshottari

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/astrobro.db

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AUTO_APPROVE_PAYMENTS=false
PAID_REPORT_PRICE=4900

# --- Security ---
# Clients send this as the X-API-Key header. Empty disables the check (local dev only).
API_KEY=
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# --- Sign-in (Firebase Auth ID tokens) ---
FIREBASE_PROJECT_ID=astro-bro-96380
# false = older app versions that send only the API key still work. Switch to true once the new app is out.
REQUIRE_ID_TOKEN=false
# Owners allowed to use /api/admin/* (comma separated). An email counts only if Firebase says it is verified.
ADMIN_EMAILS=
ADMIN_UIDS=

# --- Plans, wallet and consultations ---
FREE_CHATS_PER_DAY=10
PREMIUM_CHATS_PER_DAY=300
PLATFORM_COMMISSION_PERCENT=30
# Optional: lets Razorpay confirm payments even if the app is closed (set the same secret in the Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=

# --- LLM capacity ---
# Groq limits tokens per minute per model, so a rate-limited chat moves to the next model at once.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# Optional backup provider (any OpenAI-compatible API) used when every Groq model is busy, e.g. Cerebras or Gemini.
#   Gemini:        https://generativelanguage.googleapis.com/v1beta/openai   model gemini-flash-lite-latest
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# More backups, tried in order after the first (each needs all three values; a half-filled set is ignored):
#   NVIDIA NIM:    https://integrate.api.nvidia.com/v1
#   OpenRouter:    https://openrouter.ai/api/v1     (use a model whose name ends in :free)
LLM_FALLBACK2_BASE_URL=
LLM_FALLBACK2_API_KEY=
LLM_FALLBACK2_MODEL=
LLM_FALLBACK3_BASE_URL=
LLM_FALLBACK3_API_KEY=
LLM_FALLBACK3_MODEL=
