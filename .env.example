# Copy to .env and fill in. Never commit the real .env.

# --- App ---
APP_NAME="AstroBro AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-64-char-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_CLASSIFIER_MODEL=qwen/qwen3.8-27b
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Vector DB (Qdrant Cloud) ---
QDRANT_URL=
QDRANT_API_KEY=
BOOKS_COLLECTION=vedic_books
# Tarot, numerology, Vastu, festival, calendar and Puranic-lore books (see scripts/free_books.py). Empty disables it.
SPECIALIST_COLLECTION=specialist_books

# --- Embeddings (run locally with fastembed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Astrology ---
AYANAMSA=LAHIRI
HOUSE_SYSTEM=W
DASHA_SYSTEM=vimshottari

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/astrobro.db

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AUTO_APPROVE_PAYMENTS=false
PAID_REPORT_PRICE=4900

# --- Security ---
# Clients send this as the X-API-Key header. Empty disables the check (local dev only).
API_KEY=
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
